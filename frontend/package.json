{
  "name": "gestion-cocktail",
  "version": "0.8.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 4201 --ssl --ssl-cert certs/openbar.crt --ssl-key certs/openbar.key",
    "start:lan": "ng serve --host 0.0.0.0 --port 4201 --ssl --ssl-cert certs/openbar.crt --ssl-key certs/openbar.key",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless --code-coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:network-resilience": "playwright test e2e/commandes/degraded-network-resilience.spec.ts",
    "test:load": "node ../tests/load/run-load-tests.js",
    "perf:smoke": "node ../tests/load/run-load-tests.js --scenario=smoke",
    "perf:rush-hour": "node ../tests/load/run-load-tests.js --scenario=rush-hour",
    "perf:websocket": "node ../tests/load/run-load-tests.js --scenario=websocket",
    "perf:patron-cart": "node ../tests/load/run-load-tests.js --scenario=patron-cart",
    "perf:billing": "node ../tests/load/run-load-tests.js --scenario=billing",
    "perf:all": "node ../tests/load/run-load-tests.js --scenario=all",
    "perf:profile": "node ../scripts/benchmark-profile.js --duration=60",
    "docker:app:start": "node ../tests/load/run-load-tests.js --scenario=smoke",
    "sonar": "npm run test:ci && npx sonar-scanner -Dsonar.qualitygate.wait=true"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/platform-browser-dynamic": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@ionic/angular": "^9.0.6",
    "@jsverse/transloco": "^8.4.0",
    "@ngrx/effects": "^22.0.1",
    "@ngrx/store": "^22.0.1",
    "@ngrx/store-devtools": "^22.0.1",
    "@stomp/rx-stomp": "^2.4.0",
    "@stomp/stompjs": "^7.3.0",
    "idb": "^8.0.3",
    "konva": "^10.7.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.1",
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@babel/core": "^8.0.6",
    "@playwright/test": "^1.63.0",
    "@types/jasmine": "~7.0.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "karma-junit-reporter": "^2.0.1",
    "sonar-scanner": "^3.1.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "postcss": "^8.5.3",
    "http-proxy-middleware": "^3.0.7",
    "uuid": "^11.1.1",
    "qs": "^6.16.0",
    "piscina": "^5.3.2"
  }
}
