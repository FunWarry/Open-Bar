{
  "name": "gestion-cocktail",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0",
    "start:lan": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless --code-coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "sonar": "npm run test:ci && npx sonar-scanner -Dsonar.qualitygate.wait=true"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.30",
    "@angular/common": "^20.3.30",
    "@angular/compiler": "^20.3.30",
    "@angular/core": "^20.3.30",
    "@angular/forms": "^22.1.4",
    "@angular/platform-browser": "^20.3.30",
    "@angular/platform-browser-dynamic": "^20.3.30",
    "@angular/router": "^22.1.4",
    "@ionic/angular": "^8.8.11",
    "@jsverse/transloco": "^8.4.0",
    "@ngrx/effects": "^22.0.0",
    "@ngrx/store": "^22.0.0",
    "@ngrx/store-devtools": "^22.0.0",
    "@stomp/rx-stomp": "^2.4.0",
    "@stomp/stompjs": "^7.3.0",
    "konva": "^10.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.22",
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "@playwright/test": "^1.62.1",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "karma-junit-reporter": "^2.0.1",
    "sonar-scanner": "^3.1.0",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.3",
    "http-proxy-middleware": "^3.0.7",
    "uuid": "^11.1.1",
    "qs": "^6.16.0"
  }
