# Force LF line endings et pas de BOM sur les fichiers source
*.java text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.sh text eol=lf

# Binaires — pas de conversion
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.pdf binary
